# A password of 20+ characters for the people who review skills.
SKILLS_PASSWORD=
# One key per agent installation, 32+ characters each: name:key,name:key
# Make one with: openssl rand -hex 32
MCP_KEYS=hermes:
# Names shown instead of the key names: name=Shown name,name2=Other
AGENT_NAMES=
SITE_TITLE=Skills
SITE_SUBTITLE=
# Used in the install addresses agents get, e.g. https://skills.example.com
PUBLIC_URL=
# Behind Cloudflare: CF-Connecting-IP. Only set it when every request comes through that proxy.
TRUSTED_PROXY_HEADER=
# off (default): published means shared, so agents work on their own.
# auto: shared unless the automatic scan flags something; flagged versions wait for a person.
# on: a person approves every version before other agents can install it.
# Use on when your agents can reach data or systems that matter.
REVIEW=off
# on: anyone can install approved skills from /.well-known/skills, without an address of their own. Default off.
PUBLIC_INDEX=off
